# ── Next.js (.env.local locally; Vercel → Project → Settings → Environment Variables) ──
# Written for you by `npx convex dev` locally; set by `convex deploy` on Vercel.
NEXT_PUBLIC_CONVEX_URL=

# Clerk → API keys. Leave both empty to run locally as a single dev user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel only: Convex dashboard → Settings → Deploy key (Production).
CONVEX_DEPLOY_KEY=

# ── Convex backend (set with `npx convex env set NAME value`, not in this file) ──
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL
# R2_BUCKET R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_TOKEN
# CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_AI_TOKEN      (Workers AI, free tier)
# AI_BASE_URL AI_API_KEY AI_MODEL                (optional: any OpenAI-compatible server)
